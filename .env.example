# ==============================================================================
# CardioLens 3D — Production Environment Template
# ==============================================================================
# Note: CardioLens 3D operates with zero external configuration out of the box.
# If no external AI key is supplied, the built-in deterministic clinical decision
# engine synthesizes all multi-target diagnostic covariates automatically.
#
# Optional: External AI Provider Keys (Kept server-side only)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Server Port Configuration (Defaults to 3000)
PORT=3000
NODE_ENV=production
